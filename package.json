{
  "name": "tienda-cliente",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "build": "turbo run build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "start:web": "pnpm --filter web start",
    "start:api": "pnpm --filter api start:prod",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:a11y": "pnpm --filter web test:a11y",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check \u0026\u0026 pnpm lint \u0026\u0026 pnpm typecheck \u0026\u0026 pnpm test \u0026\u0026 pnpm build",
    "ci": "pnpm install --frozen-lockfile \u0026\u0026 pnpm check \u0026\u0026 pnpm test:e2e",
    "db:format": "pnpm --filter api prisma:format",
    "db:validate": "pnpm --filter api prisma:validate",
    "db:generate": "pnpm --filter api prisma:generate",
    "db:migrate": "pnpm --filter api prisma:migrate:dev",
    "db:deploy": "pnpm --filter api prisma:migrate:deploy",
    "db:seed": "pnpm --filter api prisma:seed",
    "db:studio": "pnpm --filter api prisma:studio",
    "db:smoke": "pnpm --filter api prisma:smoke",
    "db:typecheck": "pnpm --filter api prisma:typecheck"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "6.0.3"
  }
}
