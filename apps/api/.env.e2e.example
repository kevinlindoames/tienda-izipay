# Copy this file to .env.e2e.local. Never commit the local copy.
# Use the direct connection or the shared session pooler on port 5432.
# Provisioner URL: database postgres, role postgres, sslmode=verify-full.
# Legacy require/verify-ca inputs are upgraded to verify-full in memory.
# Trust the downloaded CA via NODE_EXTRA_CA_CERTS before starting Node.
# The API uses a separate short-lived runtime role; do not configure it here.
DATABASE_URL_E2E=
E2E_PROJECT_REF=xggarsmihlmqbdvnicks

# Use a test-only password between 12 and 72 UTF-8 bytes.
E2E_ADMIN_PASSWORD=
